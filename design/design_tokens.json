      "white": "#FFFFFF"
    },
    "derived": {
      "textSecondary": "#6B5E56",
      "textOnPrimary": "#FFFFFF",
      "textOnGold": "#0D1F45",
      "textOnPink": "#0D1F45",
      "errorText": "#C4404C",
      "success": "#2F7A4B",
      "outline": "#E3D3B6",
      "outlineStrong": "#C9B48A",
      "disabledSurface": "#EFE6D6",
      "disabledText": "#8E8178",
      "scrim": "rgba(13, 31, 69, 0.55)",
      "shadowColor": "rgba(13, 31, 69, 0.18)",
      "pressedOverlay": "rgba(13, 31, 69, 0.12)"
