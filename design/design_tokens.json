      "surfaceParentPage": "parentBackground",
      "surfaceParentCard": "backgroundCream",
      "textDefault": "textPrimary",
      "textHeading": "textDarkBlue",
      "textMuted": "textSecondary",
      "textError": "errorText",
      "iconError": "error",
      "badgePremium": "accentGold",
      "badgePremiumText": "textDarkBlue",
      "favorite": "accentPink",
      "listenAccent": "storyBlue",
      "progress": "primary",
      "progressTrack": "surfaceSand",
      "completed": "success",
      "overlayScrim": "scrim"
    },
    "gradients": {
      "nightSky": {
        "direction": "top-to-bottom",
        "stops": ["#0D1F45", "#122EA1", "#066CDE"],
        "usage": "decorative backgrounds only, never behind body text"
      },
      "celebration": {
        "direction": "start-to-end",
        "stops": ["#F5B83D", "#EE7692"],
        "usage": "story-complete accents only"
      }
    },
    "flutterflowThemeSlots": {
      "primary": "primary",
      "secondary": "storyBlue",
      "tertiary": "accentGold",
      "alternate": "surfaceSand",
      "primaryText": "textPrimary",
      "secondaryText": "textSecondary",
      "primaryBackground": "backgroundCream",
      "secondaryBackground": "parentBackground",
      "accent1": "primaryLight",
      "accent2": "accentPink",
      "accent3": "storyBlueDark",
      "accent4": "textDarkBlue",
      "success": "success",
      "error": "error",
      "warning": "accentGold",
      "info": "storyBlue"
    },
    "contrastMinimums": {
      "bodyText": 4.5,
      "largeText": 3.0,
      "nonTextUi": 3.0,
      "largeTextThresholdBoldPx": 18.66,
      "largeTextThresholdRegularPx": 24
    },
    "darkMode": "not-supported-in-mvp"
  },
  "typography": {
    "families": {
      "display": {
        "name": "Baloo Bhaijaan 2",
        "weights": [600, 700, 800],
        "arabicSupport": true,
        "diacriticsSupport": "verify-on-device",
        "licence": "verify-OFL-and-bundle"
      },
      "body": {
        "name": "Tajawal",
        "weights": [400, 500, 700, 800],
        "arabicSupport": true,
        "diacriticsSupport": "verify-on-device-before-lock",
        "fallbackForStoryBodyIfDiacriticsFail": "Noto Naskh Arabic",
        "licence": "verify-OFL-and-bundle"
      },
      "rule": "never configure a font without full Arabic coverage anywhere in the theme"
    },
    "roles": {
      "displayLarge": { "family": "display", "weight": 800, "size": 34, "lineHeight": 1.3, "flutterflowSlot": "displayLarge" },
      "displayMedium": { "family": "display", "weight": 700, "size": 30, "lineHeight": 1.3, "flutterflowSlot": "displayMedium" },
      "displaySmall": { "family": "display", "weight": 700, "size": 28, "lineHeight": 1.3, "flutterflowSlot": "displaySmall" },
      "headlineMedium": { "family": "display", "weight": 600, "size": 24, "lineHeight": 1.35, "flutterflowSlot": "headlineMedium" },
      "headlineSmall": { "family": "display", "weight": 600, "size": 22, "lineHeight": 1.35, "flutterflowSlot": "headlineSmall" },
      "titleLarge": { "family": "body", "weight": 700, "size": 22, "lineHeight": 1.4, "flutterflowSlot": "titleLarge" },
      "titleMedium": { "family": "body", "weight": 700, "size": 20, "lineHeight": 1.4, "flutterflowSlot": "titleMedium" },
      "titleSmall": { "family": "body", "weight": 700, "size": 18, "lineHeight": 1.4, "flutterflowSlot": "titleSmall" },
      "storyBody": { "family": "body", "weight": 500, "size": 26, "lineHeight": 1.9, "flutterflowSlot": "bodyLarge-overridden" },
      "bodyLarge": { "family": "body", "weight": 400, "size": 18, "lineHeight": 1.6, "flutterflowSlot": "bodyLarge" },
      "bodyMedium": { "family": "body", "weight": 400, "size": 16, "lineHeight": 1.6, "flutterflowSlot": "bodyMedium" },
      "bodySmall": { "family": "body", "weight": 400, "size": 14, "lineHeight": 1.5, "flutterflowSlot": "bodySmall", "childModeAllowed": false },
      "labelLarge": { "family": "body", "weight": 700, "size": 16, "lineHeight": 1.4, "flutterflowSlot": "labelLarge" },
      "labelMedium": { "family": "body", "weight": 500, "size": 14, "lineHeight": 1.4, "flutterflowSlot": "labelMedium", "childModeAllowed": false }
    },
    "storyBodyByAgeGroup": {
      "1-2": 30,
      "3-4": 28,
      "5-6": 26,
      "minimum": 22
    },
    "rules": {
      "storyTextMinimumPx": 22,
      "primaryButtonTextPx": [20, 22],
      "pageTitlePx": [28, 34],
      "childModeMinimumTextPx": 16,
      "parentModeMinimumTextPx": 14,
      "lineHeightWithDiacriticsMin": 1.8,
      "letterSpacing": 0,
      "textAlign": "start",
      "justify": false,
      "fauxBold": false,
      "textScaleClampChildMode": 1.3
    }
  },
  "fontSizes": {
    "xs": 14,
    "sm": 16,
    "md": 18,
    "lg": 20,
    "xl": 22,
    "2xl": 24,
