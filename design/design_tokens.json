    "source": "docs/DESIGN_SYSTEM.md",
    "confirmedByOwner": ["colors.base", "typography.families", "layout.spacing", "touchTargets", "componentHeights.primaryButtonChild", "radii.card", "radii.pill", "rtl"]
  },
  "brand": {
    "name": "Kids Stories",
    "nameArabic": "",
    "nameArabicStatus": "pending-owner-decision-D-29",
    "audience": "children aged 1-6 and their parents",
    "ageGroups": ["1-2", "3-4", "5-6"],
    "visualDirection": "polished magical storybook: night skies, soft clouds, castles, stars, books, lanterns, gentle animals, cream surfaces, purple actions, gold highlights",
    "artworkPolicy": "original or properly licensed only; reference images are mood only"
  },
  "colors": {
    "base": {
      "primary": "#7442C8",
      "primaryLight": "#916BC1",
      "storyBlueDark": "#122EA1",
      "storyBlue": "#066CDE",
      "backgroundCream": "#FFF8EA",
      "surfaceSand": "#F0DCB2",
      "parentBackground": "#F8ECE9",
      "accentGold": "#F5B83D",
      "accentPink": "#EE7692",
      "textPrimary": "#40352F",
      "textDarkBlue": "#0D1F45",
